# Runtime: development, testing, or production
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Local SQLite is used when DATABASE_URL is unset.
# Production example: postgresql+psycopg://user:password@db:5432/blogging_platform
# DATABASE_URL=

# Comma-separated exact browser origins; do not use * with credentials.
CORS_ORIGINS=http://localhost:5173
# Required in production for shared caching and rate-limit storage.
REDIS_URL=
FRONTEND_BASE_URL=http://localhost:5173

# Email (required to send verification and password-reset messages)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Upload and request limits (bytes)
MAX_CONTENT_LENGTH=5242880
MAX_IMAGE_UPLOAD_BYTES=5242880
UPLOAD_FOLDER=instance/uploads

# Enable these when serving over HTTPS in production.
SESSION_COOKIE_SECURE=false
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
